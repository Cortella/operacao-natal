# Copie para .env e preencha. Nunca faça commit do .env.

# --- Aplicação ---
# URL pública, sem barra no final. Usada nos links dos presentes e nos webhooks.
APP_URL="http://localhost:3000"

# --- Banco de dados (PostgreSQL) ---
# Valor abaixo corresponde ao docker-compose.yml local.
DATABASE_URL="postgresql://noel:noel@localhost:54329/oficina_do_noel?schema=public"

# --- Autenticação (Step 3) ---
# Gere com: openssl rand -base64 32
AUTH_SECRET=""

# --- Storage compatível com S3 (Step 5) ---
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL pública base dos arquivos (CDN ou bucket público)
S3_PUBLIC_URL=""

# --- Gateway de pagamento (Step 7) ---
PAYMENT_ACCESS_TOKEN=""
PAYMENT_WEBHOOK_SECRET=""

# --- Primeiro administrador (usado apenas por `npm run db:seed`) ---
ADMIN_EMAIL=""
# Mínimo de 10 caracteres.
ADMIN_PASSWORD=""
