# Copie para .env e preencha. Nunca faça commit do .env.

# --- Aplicação ---
# URL pública, sem barra no final. Usada nos links dos presentes e nos webhooks.
APP_URL="http://localhost:3000"

# --- Banco de dados (PostgreSQL) ---
# Valor abaixo corresponde ao docker-compose.yml local.
DATABASE_URL="postgresql://noel:noel@localhost:54329/oficina_do_noel?schema=public"

# --- E-mail transacional (Resend) ---
# Sem estes valores, em desenvolvimento os e-mails aparecem no terminal do servidor.
RESEND_API_KEY=""
# Ex.: "Oficina do Noel <ola@seudominio.com>"
EMAIL_FROM=""

# --- Storage compatível com S3 ---
# Os valores abaixo correspondem ao MinIO do docker-compose.yml local.
# Em produção, use as credenciais do seu serviço (AWS S3, Cloudflare R2, Supabase Storage).
S3_ENDPOINT="http://localhost:59000"
S3_REGION="us-east-1"
S3_BUCKET="oficina-do-noel"
S3_ACCESS_KEY_ID="noel"
S3_SECRET_ACCESS_KEY="noel-storage"
# Endereço público base dos arquivos (CDN ou bucket público), sem barra no final.
S3_PUBLIC_URL="http://localhost:59000/oficina-do-noel"
# "true" para MinIO e outros serviços que não usam o bucket como subdomínio.
S3_FORCE_PATH_STYLE="true"

# --- Gateway de pagamento (Step 7) ---
PAYMENT_ACCESS_TOKEN=""
PAYMENT_WEBHOOK_SECRET=""

# --- Primeiro administrador (usado apenas por `npm run db:seed`) ---
ADMIN_EMAIL=""
# Mínimo de 10 caracteres.
ADMIN_PASSWORD=""
